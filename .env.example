# CollegePredictor Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string
# For local: postgresql://user:password@localhost:5432/college_predictor
# For Neon: postgresql://user:password@host.neon.tech/college_predictor?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_predictor"

# Admin panel authentication secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send as x-admin-token header or admin-token cookie.
ADMIN_SECRET=""

