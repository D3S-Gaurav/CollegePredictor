    /*
     * ================================================================
     * PRINT CLOUDLET RESULTS
     * ================================================================
     */
 
    private static void printCloudletList(
            List<Cloudlet> list) {
 
        int size =
                list.size();
 
        Cloudlet cloudlet;
 
 
        String indent = " ";
 
 
        Log.printLine();
 
        Log.printLine(
                "================ OUTPUT ================"
        );
 
 
        Log.printLine(
                "Cloudlet ID"
                + indent
                + "STATUS"
                + indent
                + "Data Center ID"
                + indent
                + "VM ID"
                + indent
                + "Execution Time"
                + indent
                + "Waiting Time"
                + indent
                + "Start Time"
                + indent
                + "Finish Time"
        );
 
 
        DecimalFormat dft =
                new DecimalFormat("###.##");
 
 
        for (int i = 0; i < size; i++) {
 
            cloudlet =
                    list.get(i);
 
 
            if (cloudlet.getCloudletStatus()
                    == Cloudlet.SUCCESS) {
 
 
                double executionTime =
                        cloudlet.getActualCPUTime();
 
 
                double startTime =
                        cloudlet.getExecStartTime();
 
 
                double finishTime =
                        cloudlet.getFinishTime();
 
 
                double waitingTime =
                        startTime;
 
 
                Log.printLine(
                        indent
                        + cloudlet.getCloudletId()
 
                        + indent
                        + "SUCCESS"
 
                        + indent
                        + cloudlet.getResourceId()
 
                        + indent
                        + cloudlet.getVmId()
 
                        + indent
                        + dft.format(
                                executionTime
                        )
 
                        + indent
                        + dft.format(
                                waitingTime
                        )
 
                        + indent
                        + dft.format(
                                startTime
                        )
 
                        + indent
                        + dft.format(
                                finishTime
                        )
                );
            }
        }
    }
 
 
    /*
     * ================================================================
     * CALCULATE ASSIGNMENT METRICS
     * ================================================================
     */
 
    private static void printMetrics(
            List<Cloudlet> list) {
 
        if (list == null || list.isEmpty()) {
 
            System.out.println(
                    "No cloudlets completed."
            );
 
            return;
        }
 
 
        double makespan = 0;
 
        double totalCompletionTime = 0;
 
        double totalWaitingTime = 0;
 
        double totalExecutionTime = 0;
 
 
        for (Cloudlet cloudlet : list) {
 
            if (cloudlet.getCloudletStatus()
                    == Cloudlet.SUCCESS) {
 
 
                double start =
                        cloudlet.getExecStartTime();
 
 
                double finish =
                        cloudlet.getFinishTime();
 
 
                double execution =
                        cloudlet.getActualCPUTime();
 
 
                double waiting =
                        start;
 
 
                /*
                 * Makespan is the largest finish time.
                 */
 
                if (finish > makespan) {
 
                    makespan = finish;
                }
 
 
                totalCompletionTime +=
                        finish;
 
 
                totalWaitingTime +=
                        waiting;
 
 
                totalExecutionTime +=
                        execution;
            }
        }
 
 
        int n = list.size();
 
 
        double averageCompletionTime =
                totalCompletionTime / n;
 
 
        double averageWaitingTime =
                totalWaitingTime / n;
 
 
        double averageExecutionTime =
                totalExecutionTime / n;
 
 
        DecimalFormat df =
                new DecimalFormat("###.##");
 
 
        System.out.println();
 
        System.out.println(
                "=============================================="
        );
 
        System.out.println(
                "             PERFORMANCE METRICS"
        );
 
        System.out.println(
                "=============================================="
        );
 
 
        System.out.println(
                "Algorithm               : "
                + getAlgorithmName()
        );
 
 
        System.out.println(
                "Makespan                : "
                + df.format(makespan)
        );
 
 
        System.out.println(
                "Average Completion Time : "
                + df.format(
                        averageCompletionTime
                )
        );
 
 
        System.out.println(
                "Average Waiting Time    : "
                + df.format(
                        averageWaitingTime
                )
        );
 
 
        System.out.println(
                "Average Execution Time  : "
                + df.format(
                        averageExecutionTime
                )
        );
 
 
        System.out.println(
                "=============================================="
        );
    }
 
 
